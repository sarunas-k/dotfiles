#!/usr/bin/env zsh
# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Enable prompt substitution
setopt PROMPT_SUBST
# Set 256 color terminal
if infocmp xterm-256color >/dev/null 2>&1; then
    export TERM='xterm-256color'
fi
prompt_git() {
    local branchName=''
    # Check if the current directory is in a Git repository.
    git rev-parse --is-inside-work-tree &>/dev/null || return
    # Get the branch name or fallback options.
    branchName="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || \
        git describe --all --exact-match HEAD 2>/dev/null || \
        git rev-parse --short HEAD 2>/dev/null || \
        echo '(unknown)')"
    
    echo -e "${1}[${branchName}]${2} "
}
# Colors using tput
if tput setaf 1 &>/dev/null; then
    tput sgr0
    bold="$(tput bold)"
    reset="$(tput sgr0)"
    black="$(tput setaf 0)"
    blue="$(tput setaf 33)"
    cyan="$(tput setaf 39)"
    green="$(tput setaf 70)"
    orange="$(tput setaf 166)"
    purple="$(tput setaf 213)"
    red="$(tput setaf 124)"
    violet="$(tput setaf 63)"
    gray="$(tput setaf 244)"
    white="$(tput setaf 251)"
    yellow="$(tput setaf 179)"
else
    bold=$'\e[1m'
    reset=$'\e[0m'
    black=$'\e[1;30m'
    blue=$'\e[1;34m'
    cyan=$'\e[1;36m'
    gray=$'\e[0;37m'
    green=$'\e[1;32m'
    orange=$'\e[1;33m'
    purple=$'\e[1;35m'
    red=$'\e[1;31m'
    violet=$'\e[1;35m'
    white=$'\e[1;37m'
    yellow=$'\e[1;33m'
fi
# Wrap tput colors for zsh prompt
wrap_color() {
    echo "%{$1%}"
}
# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
    userStyle="%{${red}%}"
else
    userStyle="%{${blue}%}"
fi
# Highlight the hostname when connected via SSH.
if [[ -n "${SSH_TTY}" ]]; then
    hostStyle="%{${bold}${red}%}"
else
    hostStyle="%{${violet}%}"
fi
# Helper for git prompt with correct color wrapping
_git_info() {
    prompt_git "%{${white}%}branch " ""
}
# Helper for kubectl current context
_kube_context() {
    local ctx cluster user ns output
    ctx="$(kubectl config current-context 2>/dev/null)" || return
    cluster="${ctx%%/*}"
    user="${ctx##*/}"
    output="%{${gray}%}cluster [${cluster}/${user}]"
    ns="$(kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null)"
    [[ -n "$ns" ]] && output+=" %{${white}%}- [${ns}]"
    echo -e "${output}"
}
# Build the prompt
PROMPT=""
PROMPT+=$'%{\e]0;%~\a%}' # Terminal title: working directory
PROMPT+=$'\n'                       # Newline
PROMPT+="${userStyle}%n"            # Username
PROMPT+="%{${white}%}@"            # @
PROMPT+="${hostStyle}%m"            # Hostname
PROMPT+="%{${white}%} in "         # " in "
PROMPT+="%{${yellow}%}%~"          # Working directory full path
PROMPT+=$'\n'
PROMPT+='$(_git_info)'             # Git branch (evaluated each prompt)
PROMPT+='$(_kube_context)'         # Kube context (evaluated each prompt)
PROMPT+=$'\n'
PROMPT+="%{${white}%}%# %{${reset}%}"  # $ or # and reset
export PROMPT
# Secondary prompt
PROMPT2="%{${yellow}%}→ %{${reset}%}"
export PROMPT2
